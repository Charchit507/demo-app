<!DOCTYPE html>
<html>
  <head>
    <title>DemoApp</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <%= render "header_&_footer/header" %>
    <div class="container">
      <div class="row">
        <p style="color:green;padding: 0rem;" class="notice"><%= notice %></p>
        <p style="color:red;padding: 0rem" class="alert" style="padding:0rem"><%= alert %></p>
        <%= yield %>
      </div>
    </div>
  </body>
</html>
