<div class="col">
  <h1 style="text-align:center;text-shadow: 2px 2px 4px #000000">A R T I C L E</h1>
  <br>
  <br>
  <br>
  <div class="actions d-grid gap-2 col-6 mx-auto shadow">
    <%= link_to 'New article', new_article_path, class: "btn btn-outline-success btn-lg shadow" %>
  </div>
  <br>
  <br>
  <table class="table table-striped table-hover shadow">
    <tr class="shadow table-dark">
      <th style="padding:1.5rem;text-align:center;">Title</th>
      <th style="text-align:center;padding:1.5rem;">Text</th>
      <th style="padding: 1.5rem;text-align: center;" colspan="3">Actions</th>
    </tr>

    <% @articles.each do |article| %>
      <tr>
        <td style="padding: 1.5rem;text-align:center;"><%= article.title %></td>
        <td style="padding: 1.5rem;text-align:center;"><%= article.text %></td>
        <td style="text-align:center;padding: 1.5rem;"><%= link_to 'Show', article_path(article), style: "text-decoration:none" %></td>
        <td style="text-align:center;padding: 1.5rem"><%= link_to 'Edit', edit_article_path(article), style: "text-decoration:none" %></td>
        <td style="text-align:center;padding: 1.5rem;"><%= link_to 'Destroy', article_path(article), method: :delete, data: { confirm: 'Are you  sure?' }, style: "text-decoration:none;color:red;" %></td>
      </tr>
    <% end %>
  </table>
  <br>
</div>
